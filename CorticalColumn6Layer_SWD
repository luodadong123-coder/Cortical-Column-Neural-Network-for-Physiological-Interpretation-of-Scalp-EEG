n_columns = 19;                 % 19个皮层柱（10-20系统）
units_per_layer = 30;           % 每层30个单元
dt = 0.004;                     % 时间步长 4ms (250Hz)

% 创建6层皮层柱模型（集成SWD）
column6 = CorticalColumn6Layer_SWD(n_columns, units_per_layer, dt);
fprintf('✓ 模型初始化完成\n');
fprintf('  总单元数: %d\n', column6.total_units);

%% 2. 加载DTI数据
fprintf('\n=== 步骤2: 加载DTI结构连接 ===\n');

if exist('standard_dti_19channel.mat', 'file')
    load('standard_dti_19channel.mat', 'dti_structural_connectivity');
    
    C_dti = dti_structural_connectivity.connectivity_matrix;
    FA_values = dti_structural_connectivity.FA_values;
    
    % 10-20系统电极位置（转换为mm）
    electrode_positions = [
        -0.5, 0.8; 0.5, 0.8; -0.4, 0.4; 0.4, 0.4; -0.3, 0.0;
        0.3, 0.0; -0.4, -0.4; 0.4, -0.4; -0.3, -0.8; 0.3, -0.8;
        -0.7, 0.3; 0.7, 0.3; -0.6, -0.1; 0.6, -0.1; -0.6, -0.5;
        0.6, -0.5; 0.0, 0.5; 0.0, 0.0; 0.0, -0.5
    ] * 35;
    
    channel_labels = {
        'Fp1','Fp2','F3','F4','C3','C4','P3','P4','O1','O2',...
        'F7','F8','T3','T4','T5','T6','Fz','Cz','Pz'
    };
    
    % 设置DTI连接
    column6.setDTIConnectivity(C_dti, FA_values, electrode_positions, channel_labels);
    
    % 设置容积传导
    column6.setVolumeConduction(35, 40);
    fprintf('✓ DTI和容积传导设置完成\n');
else
    warning('未找到DTI文件，使用默认设置');
end

%% 3. 加载真实SWD检测结果
fprintf('\n=== 步骤3: 加载SWD检测结果 ===\n');

% 从之前的分析加载SWD结果
swd_file = 'SWD_detection_results.mat';
if exist(swd_file, 'file')
    column6.loadSWDResults(swd_file);
    
    % 可选：调整SWD抑制参数
    column6.setSWDSuppression(0.6, [2, 3, 5]); % 强度0.6，影响LFP、DTI、输出层
else
    fprintf('⚠ 未找到SWD结果文件，将使用空SWD列表\n');
    
    % 如果有微状态标签，可以尝试推断
    if exist('microstate_labels.mat', 'file')
        load('microstate_labels.mat', 'full_labels', 'srate');
        % 假设状态2和4可能与SWD相关
        column6.inferSWDfromMicrostates(full_labels, srate, [2, 4]);
    end
end

%% 4. 构建连接矩阵
fprintf('\n=== 步骤4: 构建连接矩阵 ===\n');
column6.buildConnectivity();

%% 5. 加载微状态标签（用于驱动输入）
fprintf('\n=== 步骤5: 加载微状态数据 ===\n');

if exist('microstate_labels.mat', 'file')
    load('microstate_labels.mat', 'full_labels', 'num_microstates', 'srate');
    fprintf('✓ 加载微状态标签: %d个样本, %d个状态\n', length(full_labels), num_microstates);
else
    error('需要微状态标签文件');
end

%% 6. 运行仿真（集成SWD抑制）
fprintf('\n=== 步骤6: 运行仿真 ===\n');

n_steps = min(10000, length(full_labels));  % 仿真步数
eeg_history = zeros(n_columns, n_steps);
lfp_history = zeros(n_columns, n_steps);
swd_history = zeros(1, n_steps);
swd_affected_history = zeros(n_columns, n_steps);

% 记录SWD发生的窗口
swd_occurrence = zeros(1, n_steps);

fprintf('仿真 %d 步...\n', n_steps);

for step = 1:n_steps
    % 生成外部输入（基于微状态）
    external_input = zeros(column6.total_units, 1);
    
    % 只给第4层（输入层）添加输入
    input_layer_idx = column6.layer_indices{column6.LAYER_INPUT};
    
    % 基于当前微状态调制输入
    current_state = full_labels(step);
    state_factor = 0.5 + 0.5 * (current_state / num_microstates);
    
    % 添加输入（包含微状态调制）
    external_input(input_layer_idx) = state_factor * (2 * randn(length(input_layer_idx), 1));
    
    % 检查当前时间点是否在SWD事件中
    is_swd = column6.isSWDTime(step);
    if is_swd
        swd_occurrence(step) = 1;
    end
    
    % 更新网络（传入时间点索引以便应用SWD抑制）
    [~, ~, swd_status] = column6.update(external_input, step);
    
    % 记录数据
    eeg_history(:, step) = column6.getEEGOutput();
    lfp_history(:, step) = column6.getLFP();
    swd_history(step) = swd_status;
    swd_affected_history(:, step) = column6.getSWDAffectedActivity();
    
    if mod(step, 1000) == 0
        fprintf('  进度: %d/%d\n', step, n_steps);
    end
end

